{
  "name": "@path/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "productName": "Path",
  "description": "Path desktop shell",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node Build.mjs",
    "dev": "npm run build && wait-on http://127.0.0.1:3000 && cross-env PATH_APP_RENDERER_URL=http://127.0.0.1:3000 electron .",
    "package": "npm run rebuild:native && electron-builder",
    "package:dir": "npm run rebuild:native && electron-builder --dir",
    "rebuild:native": "node scripts/RebuildNative.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@path/database": "*",
    "@path/recording-core": "*",
    "@path/shared": "*",
    "@path/transcription": "*",
    "better-sqlite3": "^12.2.0",
    "ffmpeg-static": "^5.3.0",
    "pngjs": "^7.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.0.0",
    "electron": "42.9.3",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "wait-on": "^8.0.4",
    "prebuild-install": "^7.1.3"
  },
  "build": {
    "appId": "app.path.desktop",
    "productName": "Path",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../renderer/out",
        "to": "renderer"
      },
      {
        "from": "../../packages/database/drizzle",
        "to": "migrations"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "../../node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": "../../node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg.exe"
        },
        {
          "from": "vendor/whisper/win32-x64/Release",
          "to": "whisper"
        }
      ],
      "target": [
        "nsis"
      ]
    }
  }
}
