# Development renderer URL (defaults to http://127.0.0.1:3000 during npm run dev)
PATH_APP_RENDERER_URL=http://127.0.0.1:3000

# Local Ollama endpoint override (defaults to http://127.0.0.1:11434)
PATH_APP_OLLAMA_URL=http://127.0.0.1:11434

# Default local vision model used for click and screenshot analysis
PATH_APP_LOCAL_VISION_MODEL=llama3.2-vision:latest

# Explicit profile directory for isolated native testing and development (optional)
# PATH_APP_USER_DATA=

# Path to Chromium or Google Chrome binary for headless renderer integration checks (optional)
# PATH_APP_BROWSER_EXECUTABLE=

# Benchmark options passed from apps/desktop/scripts/MeasurePersistence.mjs to its runner (set by the script)
# PATH_APP_BENCHMARK=

# Isolated profile directories for native integration scripts (set by the scripts themselves)
# PATH_APP_OVERLAYS_DATA=
# PATH_APP_APPEARANCE_DATA=

# Optional screenshot output path for the native titlebar check (tests/ElectronTitlebar.mjs)
# PATH_APP_APPEARANCE_SCREENSHOT=
